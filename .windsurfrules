## Code Style

### Functor pattern
All database operations live inside `Make(IO)(Http)(Auth_key)`. The bind operator is always aliased at the top:
```ocaml
module Make
    (IO : Databases_intf.IO)
    (Http : Databases_intf.Http_client with type 'a io := 'a IO.t)
    (Auth_key : Databases_intf.Auth_key) =
struct
  let ( let* ) = IO.bind
  ...
end
```

### Path helpers — never inline path strings
```ocaml
(* WRONG *)
let path = "/dbs/" ^ dbname ^ "/colls/" ^ coll_name ^ "/docs/" ^ doc_id

(* RIGHT — use the existing helpers in Collection *)
let path = path_of_doc dbname coll_name doc_id
```
Existing helpers: `path_of_doc`, `path_of_docs`, `path_of_collection`, `path_of_collections`.

### Header building — always pipe with existing helpers
```ocaml
(* WRONG — manual conditionals *)
let hdrs = json_headers Account.Docs Utilities.Verb.Post coll_path in
let hdrs = match is_upsert with
  | None -> hdrs
  | Some v -> Cohttp.Header.add hdrs "x-ms-documentdb-is-upsert" (string_of_bool v)
in

(* RIGHT — pipe with Utilities.apply_to_header_if_some *)
let hdrs =
  json_headers Account.Docs Utilities.Verb.Post coll_path
  |> Utilities.apply_to_header_if_some "x-ms-documentdb-is-upsert" string_of_bool is_upsert
  |> Utilities.apply_to_header_if_some "x-ms-indexing-directive" string_of_indexing_directive indexing_directive
  |> add_header "x-ms-documentdb-partitionkey" (string_of_partition_key partition_key)
```

### Option handling — use Option.fold, not match
```ocaml
(* WRONG *)
let optional_fields =
  match opt1 with Some v -> ("key", v) :: acc | None -> acc

(* RIGHT *)
let add_field name opt acc =
  Option.fold opt ~none:acc ~some:(fun v -> (name, v) :: acc)
```

### Retry and throttle — reuse with_throttle_retry
```ocaml
(* WRONG — inline retry loop *)
let rec post retry () =
  IO.catch (fun () ->
    let* r = Http.post ~headers ~body uri in
    if code = 429 then ... post (retry-1) ()
    else ...)

(* RIGHT — use the shared helper *)
let do_post () = Http.post ~headers:hdrs ~body:content uri in
let* retry_result = with_throttle_retry ~max_retries:10 do_post in
```

### Verbatim strings for JSON
```ocaml
(* WRONG *)
Printf.sprintf "{\"path\": \"%s\", \"op\": \"add\", \"value\": %s}" path value

(* RIGHT *)
Printf.sprintf {|{"path": "%s", "op": "add", "value": %s}|} path value
```

### Naming conventions
- Conversion functions: `string_of_*` and `*_of_string`
- Labeled args (`~name`) for all non-obvious parameters
- Optional args (`?name`) for parameters with sensible defaults

